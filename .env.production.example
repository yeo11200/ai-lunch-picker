# Vercel Dashboard → Settings → Environment Variables 에 그대로 등록.
# `NEXT_PUBLIC_*` 만 브라우저에 노출됨. 나머지는 서버 전용.
#
# 절대 실제 값을 이 파일에 채우지 말 것. 실제 값은 .env.local 또는 Vercel Env Var 에만.

# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# 운영에선 service_role 발급해서 채우면 RLS 우회 가능 (선택)
SUPABASE_SERVICE_ROLE_KEY=
# Vercel에선 DB direct connection을 안 쓰므로 비워둠
SUPABASE_DB_PASSWORD=
SUPABASE_DB_CONNECTION_STRING=
SUPABASE_AUTO_APPLY_SCHEMA=false

# === Naver 개발센터 (Local Search) — https://developers.naver.com ===
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# === Naver Cloud Platform (Geocoding) — https://console.ncloud.com ===
NAVER_MAPS_API_KEY_ID=
NAVER_MAPS_API_KEY=

# === OpenRouter (무료 모델만) — https://openrouter.ai ===
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=z-ai/glm-4.5-air:free,qwen/qwen3-next-80b-a3b-instruct:free,openai/gpt-oss-20b:free,deepseek/deepseek-v4-flash:free
OPENROUTER_APP_TITLE=AI Lunch Picker
# Vercel 도메인 확정되면 명시. 비우면 VERCEL_URL이 자동 사용됨
OPENROUTER_APP_URL=

# === Base Location — 네이버 지도 placeId 와 좌표 ===
BASE_PLACE_PROVIDER=naver
BASE_PLACE_ID=
BASE_PLACE_NAME=
BASE_LATITUDE=
BASE_LONGITUDE=
BASE_RADIUS_METERS=450

# === Lunch Policy ===
MAX_LUNCH_PRICE=14000
VOTE_REVEAL_TIME=11:20
TIMEZONE=Asia/Seoul
